APP_URL=https://your-domain.example
NEXT_PUBLIC_API_URL=https://your-domain.example/api

# MySQL Database
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database

# Admin session cookie signing (any long random string). Falls back to
# DB_PASSWORD if unset — set this explicitly in production.
ADMIN_SESSION_SECRET=

# Email notifications (via Resend: https://resend.com)
# Get your API key from https://resend.com/api-keys
# Set these values in .env.production.local (not committed for security)
RESEND_API_KEY=
# Who the ADMIN gets "New Booking" alerts at.
# Note (test mode): until a domain is verified on Resend, it only delivers
# to the Resend account owner's own email.
NOTIFY_EMAIL=
# The sender MUST be on a domain verified with Resend. Until your domain is
# verified, use the default @resend.dev sender (only delivers to the account
# owner). After verification, switch to: Your Name <no-reply@your-domain.example>
NOTIFY_FROM_EMAIL=Catia Cooking <onboarding@resend.dev>

# WhatsApp notifications (optional — WhatsApp Cloud API / Meta)
# Without these, /api/notify/whatsapp responds "not configured" instead of
# sending. Get them from https://developers.facebook.com (WhatsApp Business).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
